{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "strict": true,
        "skipLibCheck": true,
        "declaration": true,
        "declarationDir": "./dist",
        "outDir": "./dist",
        "rootDir": "./",
        "resolveJsonModule": true,
        "baseUrl": ".",
        "paths": {
            "@darkpad/sdk": [
                "./sdk/index.ts"
            ]
        },
        "types": [
            "node",
            "mocha",
            "chai"
        ]
    },
    "include": [
        "tests/**/*",
        "scripts/**/*",
        "programs/**/*",
        "sdk/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}