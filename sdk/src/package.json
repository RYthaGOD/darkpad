{
    "name": "@darkpad/noir-sdk",
    "version": "1.0.0",
    "description": "Zero-Knowledge Proof SDK for Darkpad - Generate UltraHonk proofs for private auctions",
    "main": "dist/index.js",
    "module": "dist/index.esm.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "require": "./dist/index.js",
            "import": "./dist/index.esm.js",
            "types": "./dist/index.d.ts"
        },
        "./circuits/*": "./circuits/*"
    },
    "files": [
        "dist",
        "circuits",
        "README.md"
    ],
    "scripts": {
        "build": "tsup src/index.ts --format cjs,esm --dts --clean",
        "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint src --ext .ts",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "noir",
        "zk",
        "zero-knowledge",
        "solana",
        "darkpad",
        "privacy",
        "ultrahonk",
        "barretenberg"
    ],
    "author": "Darkpad Team",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/RYthaGOD/darkpad.git",
        "directory": "sdk"
    },
    "bugs": {
        "url": "https://github.com/RYthaGOD/darkpad/issues"
    },
    "homepage": "https://github.com/RYthaGOD/darkpad#readme",
    "dependencies": {
        "@aztec/bb.js": "^3.0.2",
        "@noir-lang/noir_js": "^1.0.0-beta.18",
        "@noir-lang/types": "^1.0.0-beta.18",
        "circomlibjs": "^0.1.7",
        "js-sha3": "^0.9.3"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "tsup": "^8.0.0",
        "typescript": "^5.4.0",
        "vitest": "^1.0.0"
    },
    "peerDependencies": {
        "@solana/web3.js": "^1.95.0"
    },
    "engines": {
        "node": ">=18.0.0"
    }
}